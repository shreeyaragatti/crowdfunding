# BetterFund environment template. Copy this file to `.env` and fill values.

NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME=Sepolia
NEXT_PUBLIC_NATIVE_CURRENCY_NAME=Sepolia Ether
NEXT_PUBLIC_NATIVE_CURRENCY_SYMBOL=ETH
NEXT_PUBLIC_NATIVE_CURRENCY_DECIMALS=18
NEXT_PUBLIC_RPC_URL=
SEPOLIA_RPC_URL=
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_OWNER_ADDRESS=

# Use `prisma` for the server-side Supabase Postgres integration.
# Use `supabase` only if browser-side Supabase APIs are needed.
NEXT_PUBLIC_BACKEND_PROVIDER=prisma
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_CAMPAIGN_IMAGE_BUCKET=campaign-images
NEXT_PUBLIC_CAMPAIGN_PROOF_BUCKET=campaign-proofs

# Optional donor assistant. Keep this server-side only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=gpt-4o-mini
OPENROUTER_API_HOST=https://openrouter.ai/api

# Prisma / Supabase Postgres. Use transaction pooling for app runtime and
# session pooling for migrations/introspection.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres"

# Only needed when deploying contracts. Never expose this as NEXT_PUBLIC.
DEPLOYER_PRIVATE_KEY=
