generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model CampaignMetadata {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractAddress        String?  @unique @map("contract_address")
  creatorAddress         String   @map("creator_address")
  name                   String
  description            String
  imageUrl               String?  @map("image_url")
  targetWei              String   @map("target_wei")
  minimumContributionWei String   @map("minimum_contribution_wei")
  transactionHash        String?  @map("transaction_hash")
  status                 String   @default("draft")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([creatorAddress], map: "campaign_metadata_creator_address_prisma_idx")
  @@map("campaign_metadata")
}

model WithdrawalRequestMetadata {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignAddress  String   @map("campaign_address")
  requestIndex     Int?     @map("request_index")
  creatorAddress   String   @map("creator_address")
  recipientAddress String   @map("recipient_address")
  description      String
  valueWei         String   @map("value_wei")
  transactionHash  String?  @map("transaction_hash")
  status           String   @default("created")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([campaignAddress], map: "withdrawal_request_campaign_address_prisma_idx")
  @@map("withdrawal_request_metadata")
}

model ChainEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractAddress String   @map("contract_address")
  eventName       String   @map("event_name")
  transactionHash String   @map("transaction_hash")
  blockNumber     BigInt?  @map("block_number")
  payload         Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([transactionHash, eventName], map: "chain_events_transaction_event_idx")
  @@map("chain_events")
}
